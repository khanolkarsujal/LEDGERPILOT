# LedgerPilot backend environment variables
# Copy this file to .env inside backend/ and fill in your Gemini API keys.
# NEVER commit .env to version control.

# Primary Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY_1=your_primary_gemini_api_key_here

# Secondary Google Gemini API key
# Free-tier daily quota is per Google Cloud project, not per API key:
#   GenerateRequestsPerDayPerProjectPerModel-FreeTier
# Key 2 is used only after Key 1 returns 429, and only if it may have
# independent quota (a different project). Same-project keys are skipped.
GEMINI_API_KEY_2=your_fallback_gemini_api_key_here

# Optional: Google Cloud project IDs or numbers for each key.
# Set these so LedgerPilot can skip a useless Key 2 call when both keys
# share a project. Leave unset if unknown; Key 2 is then tried at most once.
# GEMINI_CLOUD_PROJECT_1=your-gcp-project-id-or-number
# GEMINI_CLOUD_PROJECT_2=your-other-gcp-project-id-or-number

# Legacy single-key fallback (used if GEMINI_API_KEY_1 is not specified)
# GEMINI_API_KEY=your_gemini_api_key_here
